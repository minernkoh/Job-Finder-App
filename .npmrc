# Copy packages from the pnpm store into node_modules instead of reflinks.
# Reflinks can fail when the store and this repo live on different APFS volumes
# (e.g. Documents vs default pnpm store), which leaves broken or partial installs.
package-import-method=copy
# Hoisted layout reduces many small links into node_modules (fewer sync/race issues).
node-linker=hoisted
